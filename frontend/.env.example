# LifeLine Ride cockpit — frontend environment
#
# Copy to `.env.local` to override. Vite inlines these at BUILD time, so the
# dev server must be restarted after editing.

# Base URL of the FastAPI backend (no trailing slash).
# 5050 matches backend/test_api_live.py's LIVE_TEST_PORT default.
# Note: `python backend/main.py` reads PORT from the repo-root .env (5000),
# so either set PORT=5050 there or point this at http://localhost:5000.
VITE_API_URL=http://localhost:5050

# Timeline polling interval in milliseconds (spec: every 2.5 seconds).
VITE_POLL_MS=2500

# Absolute path to the repo's mockdata folder, used to build the media refs
# that hit backend/mockdata/media/.triage_cache (instant, zero-quota triage).
# MUST use backslashes and match the real checkout location exactly, or the
# cache key misses and every preset falls through to a live Gemini call.
VITE_MEDIA_ROOT=D:\LifeLine Ride\mockdata
